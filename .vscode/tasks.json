{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RepairLens Auto Deploy Watcher",
      "type": "shell",
      "command": "npm run watch-deploy",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NODE_ENV": "development"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "runOn": "folderOpen"
      }
    }
  ]
}
